APP_NAME="Buku Induk Siswa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Frontend URL (untuk CORS)
FRONTEND_URL=http://localhost:3000

# Database — PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bukuinduk
DB_USERNAME=postgres
DB_PASSWORD=secret

# Queue & Cache — Database Driver (tanpa Redis)
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# MinIO Object Storage (S3-compatible)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=bukuinduk-documents

# Authentik SSO (OIDC)
AUTHENTIK_BASE_URL=https://auth.sekolah.sch.id
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=${APP_URL}/api/auth/authentik/callback

# Field-level Encryption Key (untuk NIK)
FIELD_ENCRYPT_KEY=

# Sentry (Production Monitoring)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Telescope (Development)
TELESCOPE_ENABLED=true

# Signed URL Expiry (menit)
SIGNED_URL_EXPIRY_MINUTES=15

# Mail (untuk notifikasi export selesai)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@sekolah.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=debug
